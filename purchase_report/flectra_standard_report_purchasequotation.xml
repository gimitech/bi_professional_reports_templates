<?xml version="1.0" encoding="utf-8"?>
<flectra>
    <data>
        <template id="flectra_std_report_purchasequotation_document">
            <!-- Setup Company Context Safely -->
            <t t-if="o and 'company_id' in o">
                <t t-set="company" t-value="o.company_id"/>
            </t>
            <t t-if="not o or 'company_id' not in o">
                <t t-set="company" t-value="res_company"/>
            </t>

            <!-- Document Header Section -->
            <div class="header" style="margin-bottom: 0px; padding-bottom: 0px;">
                <div class="row mt32 mb16">
                    <div class="col-6">
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 80px;"/>
                    </div>
                    <div class="col-6 text-left" style="font:14px sans-serif !important; text-align: center;">
                        <strong t-field="company.partner_id"/><br/>
                        <span t-if="company.partner_id.street" t-field="company.partner_id.street"/><br/>
                        <span t-if="company.partner_id.street2" t-field="company.partner_id.street2"/><br/>
                        <span t-if="company.partner_id.city" t-field="company.partner_id.city"/>
                        <span t-if="company.partner_id.country_id"> <span t-field="company.partner_id.country_id.name"/></span><br/>
                        <span t-if="company.partner_id.vat">MST: <span t-field="company.partner_id.vat"/></span>
                    </div>
                </div>
                <div style="border-top: 1px solid #777777; margin-top: 5px; margin-bottom: 1px; padding: 0;"/>
            </div>

            <!-- Main Layout Context -->
            <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context({'lang':o.partner_id.lang})"/>
                <div class="page" style="font-family: sans-serif; font-size: 13px; margin-top: -55px !important;">
                    <div class="oe_structure"/>
                    
                    <!-- Document Title Block -->
                    <div class="row mb32" style="margin-top: 0px; padding-top: 1px;">
                        <div class="col-12 text-center" style="text-align: center; font-size: 13px; padding-top: 15px; margin-bottom: 15px;">
                            <h1 style="font-weight: bold; margin-top: 2px; margin-bottom: 2px; font-size: 24px; color: #333333;">
                                <t t-if="o.state == 'cancel'">YÊU CẦU BÁO GIÁ ĐÃ HỦY</t>
                                <t t-if="o.state != 'cancel'">YÊU CẦU BÁO GIÁ</t>
                            </h1>
                            <p style="font-size: 14px; color: #555;">Ref# <span t-field="o.name"/></p>
                            <img t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('Code128', o.name, 600, 100)" style="width: 300px; height: 25px;"/>
                        </div>

                        <!-- Vendor Information Section Panel -->                       
                        <div class="col-6" style="padding-right: 5px;">
                            <table class="table table-sm table-bordered" style="table-layout: fixed; width: 100%; border: 1px solid #dee2e6 !important;">
                                <thead style="background-color: #f8f9fa !important;">
                                   <tr style="background-color: #f8f9fa !important;"><th colspan="2" style="font-size: 12px; padding: 4px 8px; background-color: #f8f9fa !important; color: #333333 !important; text-align: center;">NHÀ CUNG CẤP (BÊN B)</th></tr>                                                             
                                </thead>
                                <tbody style="background-color: #ffffff !important; color: #333333 !important;">
                                    <tr style="background-color: #ffffff !important;">
                                        <td style="width: 35%; padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><strong>Đơn vị:</strong></td>
                                        <td style="width: 65%; padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><span t-field="o.partner_id.name"/></td>
                                    </tr>
                                    <tr style="background-color: #ffffff !important;">
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><strong>Địa chỉ:</strong></td>
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;">
                                            <span t-if="o.partner_id.street" t-field="o.partner_id.street"/> 
                                            <span t-if="o.partner_id.street2" t-field="o.partner_id.street2"/> 
                                            <span t-if="o.partner_id.city" t-field="o.partner_id.city"/> 
                                            <span t-if="o.partner_id.country_id"> <span t-field="o.partner_id.country_id.name"/></span>
                                        </td>
                                    </tr>
                                    <tr style="background-color: #ffffff !important;">
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><strong>Số ĐT:</strong></td>
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><span t-field="o.partner_id.phone"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Delivery Location Section Panel (Địa điểm giao hàng Bên A) -->                       
                        <div class="col-6" style="padding-left: 5px;">
                            <table class="table table-sm table-bordered" style="table-layout: fixed; width: 100%; border: 1px solid #dee2e6 !important;">
                                <thead style="background-color: #f8f9fa !important;">
                                   <tr style="background-color: #f8f9fa !important;"><th colspan="2" style="font-size: 12px; padding: 4px 8px; background-color: #f8f9fa !important; color: #333333 !important; text-align: center;">ĐỊA ĐIỂM GIAO HÀNG (BÊN A)</th></tr>                                                             
                                </thead>
                                <tbody style="background-color: #ffffff !important; color: #333333 !important;">
                                    <!-- Fallback structural check for specific drop shipping or default corporate warehouse setup -->
                                    <t t-set="delivery_addr" t-value="o.dest_address_id or o.picking_type_id.warehouse_id.partner_id or company.partner_id"/>
                                    <tr style="background-color: #ffffff !important;">
                                        <td style="width: 35%; padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><strong>Địa điểm:</strong></td>
                                        <td style="width: 65%; padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;">
                                            <strong t-field="delivery_addr.name"/>
                                        </td>
                                    </tr>
                                    <tr style="background-color: #ffffff !important;">
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><strong>Địa chỉ:</strong></td>
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;">
                                            <span t-if="delivery_addr.street" t-field="delivery_addr.street"/> 
                                            <span t-if="delivery_addr.street2" t-field="delivery_addr.street2"/> 
                                            <span t-if="delivery_addr.city" t-field="delivery_addr.city"/> 
                                            <span t-if="delivery_addr.country_id"> <span t-field="delivery_addr.country_id.name"/></span>
                                        </td>
                                    </tr>
                                    <tr style="background-color: #ffffff !important;">
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><strong>Số ĐT:</strong></td>
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;">
                                            <span t-field="delivery_addr.phone"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>                      
                    </div>

                    <!-- Information Meta Blocks -->
                    <div class="row mb16">
                        <div class="col-6" style="padding-right: 5px;">
                            <table class="table table-sm table-bordered" style="table-layout: fixed; width: 100%; border: 1px solid #dee2e6 !important;">
                                <thead style="background-color: #f8f9fa !important;">
                                    <tr style="background-color: #f8f9fa !important;"><th colspan="2" style="font-size: 12px; padding: 4px 8px; background-color: #f8f9fa !important; color: #333333 !important; text-align: center;">THÔNG TIN YÊU CẦU</th></tr>
                                </thead>
                                <tbody style="background-color: #ffffff !important; color: #333333 !important;">
                                    <tr style="background-color: #ffffff !important;">
                                        <td style="width: 40%; padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><strong>Số YCBG:</strong></td>
                                        <td style="width: 60%; padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><span t-field="o.name"/></td>
                                    </tr>
                                    <tr style="background-color: #ffffff !important;">
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><strong>Ngày yêu cầu:</strong></td>
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><span t-field="o.date_order" t-options='{"widget": "date"}'/></td>
                                    </tr>
                                    <tr style="background-color: #ffffff !important;">
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><strong>Người mua hàng:</strong></td>
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><span t-field="o.user_id"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="col-6" style="padding-left: 5px;">
                            <table class="table table-sm table-bordered" style="table-layout: fixed; width: 100%; border: 1px solid #dee2e6 !important;">
                                <thead style="background-color: #f8f9fa !important;">
                                    <tr style="background-color: #f8f9fa !important;"><th colspan="2" style="font-size: 12px; padding: 4px 8px; background-color: #f8f9fa !important; color: #333333 !important; text-align: center;">TRẠNG THÁI &amp; GIAO NHẬN</th></tr>
                                </thead>
                                <tbody style="background-color: #ffffff !important; color: #333333 !important;">
                                    <tr style="background-color: #ffffff !important;">
                                        <td style="width: 40%; padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><strong>Điều khoản:</strong></td>
                                        <td style="width: 60%; padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><span t-field="o.payment_term_id"/></td>
                                    </tr>
                                    <tr style="background-color: #ffffff !important;">
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><strong>Mã định danh:</strong></td>
                                        <td style="width: 60%; padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><span t-field="o.partner_ref"/></td>
                                    </tr>
                                    <tr style="background-color: #ffffff !important;">
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><strong>Incoterm:</strong></td>
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><span t-if="'incoterm_id' in o" t-field="o.incoterm_id.code"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <p style="font-weight: bold; margin-bottom: 6px; font-size: 12px; color: #555;">Chi tiết yêu cầu vật tư</p>
                    <table class="table table-sm table-bordered" style="table-layout: fixed; width: 100%; border: 1px solid #dee2e6 !important;">
                        <thead>                           
                            <tr style="background-color: #f8f9fa !important; color: #333333 !important; font-size: 11px;">
                                <th style="width: 8%; text-align: center; vertical-align: middle; background-color: #f8f9fa !important; color: #333333 !important;">STT</th>
                                <th style="width: 22%; text-align: center; vertical-align: middle; background-color: #f8f9fa !important; color: #333333 !important;">MÃ SẢN PHẨM</th>
                                <th style="width: 45%; text-align: center; vertical-align: middle; background-color: #f8f9fa !important; color: #333333 !important;">MÔ TẢ CHI TIẾT</th>
                                <th style="width: 10%; text-align: center; vertical-align: middle; background-color: #f8f9fa !important; color: #333333 !important;">SL</th>
                                <th style="width: 15%; text-align: center; vertical-align: middle; background-color: #f8f9fa !important; color: #333333 !important;">NGÀY YÊU CẦU</th>
                            </tr>
                        </thead>
                        <tbody style="font-size: 12px; background-color: #ffffff !important;">
                            <t t-set="line_idx" t-value="1"/>
                            <t t-foreach="o.order_line" t-as="line">
                                <tr style="background-color: #ffffff !important;">
                                    <td class="text-center" style="vertical-align: middle; background-color: #ffffff !important; color: #333333 !important;">
                                        <t t-esc="line_idx"/>
                                    </td>
                                    <td style="vertical-align: middle; background-color: #ffffff !important; color: #333333 !important;">
                                        <span t-field="line.product_id.default_code"/>
                                    </td>
                                    <td style="vertical-align: middle; background-color: #ffffff !important; color: #333333 !important;">
                                        <span t-field="line.name"/>
                                    </td>
                                    <td class="text-right" style="text-align: center; vertical-align: middle; background-color: #ffffff !important; color: #333333 !important;">
                                        <span t-field="line.product_qty"/>
                                        <span t-field="line.product_uom.name"/>
                                    </td>
                                    <td class="text-center" style="text-align: center; vertical-align: middle; background-color: #ffffff !important; color: #333333 !important;">                                        
                                        <span t-field="line.date_planned" t-options='{"widget": "date"}'/>
                                    </td>
                                    <t t-set="line_idx" t-value="line_idx + 1"/>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <div class="row justify-content-start mt24">
                        <div class="col-6">
                            <table class="table table-sm table-bordered" style="table-layout: fixed; width: 100%; border: 1px solid #ffffff !important;">   
                                <tr style="background-color: #ffffff !important; border: 0 !important;">
                                    <td style="padding: 4px 8px; min-height: 80px; background-color: #ffffff !important; color: #333333 !important; border: 0 !important;">
                                        <div class="text-center" style="text-align: center; font-size: 13px; display: block;">
                                            <t t-set="share_url" t-value="'%s/my/purchase/%s?access_token=%s' % (o.get_base_url(), o.id, o.access_token)"/>
                                            <img t-att-src="'/report/barcode/QR/%s' % (share_url)" style="width:100px; height:100px; display: inline-block; vertical-align: middle;" alt="Purchase QR"/>
                                        </div>
                                    </td>
                                </tr>  
                            </table>
                        </div>  
                    </div>
                    
                    <div class="mt32" style="border-radius: 4px; padding: 12px; background-color: #fdfdfd; font-size: 12px; border: 1px solid #eee;">
                        <p t-if="o.notes" style="margin-bottom: 0;">
                            <strong>Ghi chú:</strong><br/>
                            <span t-field="o.notes"/>
                        </p>
                    </div>

                    <div class="oe_structure"/>
                </div>
            </t>
        </template>
    </data>
</flectra>
