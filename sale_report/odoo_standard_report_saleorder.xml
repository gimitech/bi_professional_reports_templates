<?xml version="1.0" encoding="utf-8"?>
<flectra>
    <data>
        <template id="flectra_std_report_saleorder_document">
            <!-- Setup Company Context -->
            <t t-if="o and 'company_id' in o">
                <t t-set="company" t-value="o.company_id"></t>
            </t>
            <t t-if="not o or not 'company_id' in o">
                <t t-set="company" t-value="res_company"></t>
            </t>

            <!-- Document Header Section -->
            <div class="header">
                <div class="row mt32 mb32">
                    <div class="col-6">
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 80px;"/>
                    </div>
                    <div class="col-6 text-right" style="font:14px sans-serif !important; text-align: right;">
                        <strong t-field="company.partner_id"/><br/>
                        <span t-if="company.partner_id.street" t-field="company.partner_id.street"/><br/>
                        <span t-if="company.partner_id.street2" t-field="company.partner_id.street2"/><br/>
                        <span t-if="company.partner_id.city" t-field="company.partner_id.city"/>
                        <span t-if="company.partner_id.country_id">, <span t-field="company.partner_id.country_id.name"/></span><br/>
                        <span t-if="company.partner_id.vat">Tax No: <span t-field="company.partner_id.vat"/></span>
                    </div>
                </div>
            </div>

            <!-- Main Layout Context -->
            <t t-call="web.external_layout">
                <t t-set="doc" t-value="doc.with_context({'lang':doc.partner_id.lang})"/>
                <div class="page" style="font-family: sans-serif; font-size: 13px;">
                    <div class="oe_structure"/>
                    
                    <!-- Document Title and Customer Block -->
                    <div class="row mb32">
                        <div class="col-6">
                            <h2 style="font-weight: bold; margin-bottom: 2px;">Quotation</h2>
                            <p style="font-size: 14px; color: #555;">Ref# <span t-field="doc.name"/></p>
                        </div>
                        <div class="col-6 text-right" style="text-align: right; font-size: 13px;">
                            <strong>To customer:</strong><br/>
                            <span t-field="doc.partner_id.name"/><br/>
                            <span t-if="doc.partner_id.street" t-field="doc.partner_id.street"/><br/>
                            <span t-if="doc.partner_id.street2" t-field="doc.partner_id.street2"/><br/>
                            <span t-if="doc.partner_id.city" t-field="doc.partner_id.city"/>
                            <span t-if="doc.partner_id.country_id">, <span t-field="doc.partner_id.country_id.name"/></span><br/>
                            <span t-if="doc.partner_id.vat">Tax ID / TAC: <span t-field="doc.partner_id.vat"/></span>
                        </div>
                    </div>

                    <!-- Information & Status Meta Blocks -->
                    <div class="row mb16">
                        <div class="col-6">
                            <table class="table table-sm table-bordered" style="table-layout: fixed; width: 100%;">
                                <thead style="background-color: #f8f9fa;">
                                    <tr><th colspan="2" style="font-size: 12px; padding: 4px 8px;">Information</th></tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="width: 40%; padding: 4px 8px;"><strong>Quotation No.</strong></td>
                                        <td style="width: 60%; padding: 4px 8px;"><span t-field="doc.name"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 4px 8px;"><strong>Order Date:</strong></td>
                                        <td style="padding: 4px 8px;"><span t-field="doc.date_order" t-options='{"widget": "date"}'/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 4px 8px;"><strong>SalesPerson:</strong></td>
                                        <td style="padding: 4px 8px;"><span t-field="doc.user_id"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="col-6">
                            <table class="table table-sm table-bordered" style="table-layout: fixed; width: 100%;">
                                <thead style="background-color: #f8f9fa;">
                                    <tr><th colspan="2" style="font-size: 12px; padding: 4px 8px;">Status</th></tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="width: 40%; padding: 4px 8px;"><strong>Payment Term:</strong></td>
                                        <td style="width: 60%; padding: 4px 8px;"><span t-field="doc.payment_term_id"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 4px 8px;"><strong>Your Reference:</strong></td>
                                        <td style="padding: 4px 8px;"><span t-field="doc.client_order_ref"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Shipping & Invoicing Section Panels -->
                    <div class="row mb32">
                        <div class="col-6">
                            <table class="table table-sm table-bordered" style="table-layout: fixed; width: 100%;">
                                <thead style="background-color: #f8f9fa;">
                                    <tr><th style="font-size: 12px; padding: 4px 8px;">Shipping</th></tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td style="padding: 8px; min-height: 80px;">
                                            <div t-field="doc.partner_shipping_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <!-- Invoicing Information Panel -->
                        <div class="col-6" style="padding-left: 5px;">
                            <p style="font-weight: bold; font-size: 12px; margin-bottom: 4px; color: #555;">Invoicing</p>
                            <table class="table table-sm table-bordered" style="table-layout: fixed; width: 100%; margin-bottom: 15px;">
                                <tbody>
                                    <tr>
                                        <td style="width: 45%; padding: 4px 6px;">Confirmation Mode:</td>
                                        <td style="width: 55%; padding: 4px 6px; text-align: right;"><span>Manual</span></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 4px 6px;">Invoice Status:</td>
                                        <td style="padding: 4px 6px; text-align: right;"><span t-field="doc.invoice_status"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 4px 6px;">Incoterm:</td>
                                        <td style="padding: 4px 6px; text-align: right;"><span t-if="'incoterm' in doc" t-field="doc.incoterm.code"/></td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 4px 6px;">Confirmation Date:</td>
                                        <td style="padding: 4px 6px; text-align: right;"><span t-field="doc.date_order" t-options='{"widget": "date"}'/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Is there a discount on at least one line? -->
                    <t t-set="display_discount" t-value="any([l.discount for l in doc.order_line])"/>

                    <!-- Main Lines Items Table Grid -->
                    <p style="font-weight: bold; margin-bottom: 6px; font-size: 12px; color: #555;">Details</p>
                    <table class="table table-sm table-bordered" style="table-layout: fixed; width: 100%;">
                        <thead>
                            <tr t-attf-style="background-color:#{company.color_sale or '#f2f2f2'}; color:#{company.text_color_sale or '#000000'}; font-size: 11px;">
                                <th style="width: 6%; text-align: center; vertical-align: middle;">SN.</th>
                                <th style="width: 19%; vertical-align: middle;">P/N</th>
                                <th style="width: 35%; vertical-align: middle;">DESCRIPTION</th>
                                <th style="width: 11%; text-align: right; vertical-align: middle;">QUANTITY</th>
                                <th style="width: 11%; text-align: right; vertical-align: middle;">UNIT PRICE</th>
                                <th t-if="display_discount" style="width: 8%; text-align: right; vertical-align: middle;" groups="sale.group_discount_per_so_line">DISC. (%)</th>
                                <th style="width: 10%; text-align: center; vertical-align: middle;">TAXES</th>
                                <th style="width: 12%; text-align: right; vertical-align: middle;">NET PRICE*</th>
                            </tr>
                        </thead>
                        <tbody class="sale_tbody" style="font-size: 12px;">
                            <t t-set="line_idx" t-value="1"/>
                            <t t-foreach="doc.order_line" t-as="l">
                                <tr t-if="l.product_uom_qty">
                                    <td class="text-center" style="vertical-align: middle;">
                                        <t t-esc="line_idx"/>
                                    </td>
                                    <td style="vertical-align: middle;">
                                        <span t-field="l.product_id.default_code"/>
                                    </td>
                                    <td style="vertical-align: middle;">
                                        <span t-field="l.name"/>
                                    </td>
                                    <td class="text-right" style="vertical-align: middle;">
                                        <span t-field="l.product_uom_qty"/>
                                        <span groups="product.group_uom" t-field="l.product_uom"/>
                                    </td>
                                    <td class="text-right" style="vertical-align: middle;">
                                        <span t-field="l.price_unit"/>
                                    </td>
                                    <td t-if="display_discount" class="text-right" groups="sale.group_discount_per_so_line" style="vertical-align: middle;">
                                        <span t-field="l.discount"/>
                                    </td>
                                    <td class="text-center" style="vertical-align: middle;">
                                        <span t-esc="', '.join(map(lambda x: (x.description or x.name), l.tax_id))"/>
                                    </td>
                                    <td class="text-right" style="vertical-align: middle;">
                                        <span t-field="l.price_subtotal" t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}'/>
                                    </td>
                                </tr>
                                <t t-set="line_idx" t-value="line_idx + 1"/>
                            </t>
                        </tbody>
                    </table>

                    <!-- Totals and Financial Breakdown Section -->
                    <div class="row justify-content-end mt24" name="total">
                        <div class="col-5">
                            <table class="table table-sm table-bordered" style="width: 100%; font-size: 13px;">
                                <tbody>
                                    <tr>
                                        <td style="padding: 6px 8px;"><strong>Net of Taxes</strong></td>
                                        <td class="text-right" style="padding: 6px 8px;">
                                            <span t-field="doc.amount_untaxed" t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 6px 8px;">Taxes</td>
                                        <td class="text-right" style="padding: 6px 8px;">
                                            <span t-field="doc.amount_tax" t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr t-attf-style="background-color:#{company.color_sale or '#f8f9fa'}; color:#{company.text_color_sale or '#000000'}; font-weight: bold;">
                                        <td style="padding: 6px 8px;"><strong>Total</strong></td>
                                        <td class="text-right" style="padding: 6px 8px;">
                                            <span t-field="doc.amount_total" t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}'/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <!-- Terms, Conditions, and Internal Notes -->
                    <div class="mt32" style="border-radius: 4px; padding: 12px; background-color: #fdfdfd; font-size: 12px; border: 1px solid #eee;">
                        <p t-if="doc.note" style="margin-bottom: 0;">
                            <strong>Note:</strong><br/>
                            <span t-field="doc.note"/>
                        </p>
                    </div>
                    
                    <div class="oe_structure"/>
                </div>
            </t>
</template>
