<?xml version="1.0" encoding="utf-8"?>
<flectra>
    <data>
        <template id="flectra_std_report_saleorder_document">
            <!-- Setup Company Context Safely -->
            <t t-if="doc and 'company_id' in doc">
                <t t-set="company" t-value="doc.company_id"/>
            </t>
            <t t-if="not doc or 'company_id' not in doc">
                <t t-set="company" t-value="res_company"/>
            </t>

            <!-- Document Header Section -->
            <div class="header" style="margin-bottom: 0px; padding-bottom: 0px;">
                <div class="row mt32 mb16">
                    <div class="col-6">
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 80px;"/>
                    </div>
                    <div class="col-6 text-left" style="font:14px sans-serif !important; text-align: center;">
                        <strong t-field="company.partner_id"/><br/>
                        <span t-if="company.partner_id.street" t-field="company.partner_id.street"/><br/>
                        <span t-if="company.partner_id.street2" t-field="company.partner_id.street2"/><br/>
                        <span t-if="company.partner_id.city" t-field="company.partner_id.city"/>
                        <span t-if="company.partner_id.country_id">, <span t-field="company.partner_id.country_id.name"/></span><br/>
                        <span t-if="company.partner_id.vat">MST: <span t-field="company.partner_id.vat"/></span>
                    </div>
                </div>
                <!-- Horizontal Rule dividing the Top Header and Layout Body as seen in original -->
                <div style="border-top: 1px solid #777777; margin-top: 5px; margin-bottom: 1px; padding: 0;"/>
            </div>

            <!-- Main Layout Context -->
            <t t-call="web.external_layout">
                <t t-set="doc" t-value="doc.with_context({'lang':doc.partner_id.lang})"/>
                <div class="page" style="font-family: sans-serif; font-size: 13px; margin-top: -55px !important;">
                    <div class="oe_structure"/>
                    
                    <!-- Document Title and Customer Block -->
                    <div class="row mb32" style="margin-top: 0px; padding-top: 1px;">
                        <div class="col-6 text-center" style="text-align: center; font-size: 13px;">
                            <h1 style="font-weight: bold; margin-top: 2px; margin-bottom: 2px; font-size: 24px; color: #333333;">BÁO GIÁ</h1>
                            <p style="font-size: 14px; color: #555;">Ref# <span t-field="doc.name"/></p>
                        </div>

                                            <!-- Shipping & Invoicing Section Panels -->
                    <div class="row mb32">
                         <div class="col-6" style="padding-right: 5px;">
                            <table class="table table-sm table-bordered" style="table-layout: fixed; width: 100%; border: 1px solid #dee2e6 !important;">
                                <thead style="background-color: #f8f9fa !important;">
                                    <tr style="background-color: #f8f9fa !important;"><th colspan="2" style="font-size: 12px; padding: 4px 8px; background-color: #f8f9fa !important; color: #333333 !important;">Giao hàng</th></tr>
                                </thead>
                                <tbody style="background-color: #ffffff !important; color: #333333 !important;">
                                    <tr style="background-color: #ffffff !important;">
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><strong>Địa chỉ:</strong></td>
                                        <td style="padding: 8px; min-height: 80px; background-color: #ffffff !important; color: #333333 !important;">
                                            <div t-field="doc.partner_shipping_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                                        </td>
                                    </tr>
                                    <tr style="background-color: #ffffff !important;">
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><strong>Số ĐT:</strong></td>
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><span t-field="doc.partner_id.phone"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Information & Status Meta Blocks -->
                    <div class="row mb16">
                        <div class="col-6" style="padding-right: 5px;">
                            <table class="table table-sm table-bordered" style="table-layout: fixed; width: 100%; border: 1px solid #dee2e6 !important;">
                                <thead style="background-color: #f8f9fa !important;">
                                    <tr style="background-color: #f8f9fa !important;"><th colspan="2" style="font-size: 12px; padding: 4px 8px; background-color: #f8f9fa !important; color: #333333 !important;">Thông tin</th></tr>
                                </thead>
                                <tbody style="background-color: #ffffff !important; color: #333333 !important;">
                                    <tr style="background-color: #ffffff !important;">
                                        <td style="width: 40%; padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><strong> Số BG.</strong></td>
                                        <td style="width: 60%; padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><span t-field="doc.name"/></td>
                                    </tr>
                                    <tr style="background-color: #ffffff !important;">
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><strong>Ngày BG:</strong></td>
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><span t-field="doc.date_order" t-options='{"widget": "date"}'/></td>
                                    </tr>
                                    <tr style="background-color: #ffffff !important;">
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><strong>Người BG:</strong></td>
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><span t-field="doc.user_id"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="col-6" style="padding-left: 5px;">
                            <table class="table table-sm table-bordered" style="table-layout: fixed; width: 100%; border: 1px solid #dee2e6 !important;">
                                <thead style="background-color: #f8f9fa !important;">
                                    <tr style="background-color: #f8f9fa !important;"><th colspan="2" style="font-size: 12px; padding: 4px 8px; background-color: #f8f9fa !important; color: #333333 !important;">Trạng thái</th></tr>
                                </thead>
                                <tbody style="background-color: #ffffff !important; color: #333333 !important;">
                                    <tr style="background-color: #ffffff !important;">
                                        <td style="width: 40%; padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><strong>Thanh toán:</strong></td>
                                        <td style="width: 60%; padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><span t-field="doc.payment_term_id"/></td>
                                    </tr>
                                    <tr style="background-color: #ffffff !important;">
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><strong>Mã KH:</strong></td>
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><span t-field="doc.client_order_ref"/></td>
                                    </tr>
                                    <tr style="background-color: #ffffff !important;">
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><strong>Số HĐ:</strong></td>
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><span t-field="doc.client_order_ref"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Shipping & Invoicing Section Panels -->
                    <div class="row mb32">
                         <div class="col-6" style="padding-right: 5px;">
                            <table class="table table-sm table-bordered" style="table-layout: fixed; width: 100%; border: 1px solid #dee2e6 !important;">
                                <thead style="background-color: #f8f9fa !important;">
                                    <tr style="background-color: #f8f9fa !important;"><th colspan="2" style="font-size: 12px; padding: 4px 8px; background-color: #f8f9fa !important; color: #333333 !important;">Giao hàng</th></tr>
                                </thead>
                                <tbody style="background-color: #ffffff !important; color: #333333 !important;">
                                    <tr style="background-color: #ffffff !important;">
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><strong>Địa chỉ:</strong></td>
                                        <td style="padding: 8px; min-height: 80px; background-color: #ffffff !important; color: #333333 !important;">
                                            <div t-field="doc.partner_shipping_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                                        </td>
                                    </tr>
                                    <tr style="background-color: #ffffff !important;">
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><strong>Số ĐT:</strong></td>
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><span t-field="doc.partner_id.phone"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <!-- Invoicing Information Panel -->
                        <div class="col-6" style="padding-left: 5px;">
                            <table class="table table-sm table-bordered" style="table-layout: fixed; width: 100%; border: 1px solid #dee2e6 !important;">
                                <thead style="background-color: #f8f9fa !important;">
                                    <tr style="background-color: #f8f9fa !important;"><th colspan="2" style="font-size: 12px; padding: 4px 8px; background-color: #f8f9fa !important; color: #333333 !important;">Hoá đơn</th></tr>
                                </thead>
                                <tbody style="background-color: #ffffff !important; color: #333333 !important;">
                                    <tr style="background-color: #ffffff !important;">
                                        <td style="width: 45%; padding: 4px 6px; background-color: #ffffff !important; color: #333333 !important;">Confirmation Mode:</td>
                                        <td style="width: 55%; padding: 4px 6px; text-align: right; background-color: #ffffff !important; color: #333333 !important;"><span>Manual</span></td>
                                    </tr>
                                    <tr style="background-color: #ffffff !important;">
                                        <td style="padding: 4px 6px; background-color: #ffffff !important; color: #333333 !important;">Invoice Status:</td>
                                        <td style="padding: 4px 6px; text-align: right; background-color: #ffffff !important; color: #333333 !important;"><span t-field="doc.invoice_status"/></td>
                                    </tr>
                                    <tr style="background-color: #ffffff !important;">
                                        <td style="padding: 4px 6px; background-color: #ffffff !important; color: #333333 !important;">Incoterm:</td>
                                        <td style="padding: 4px 6px; text-align: right; background-color: #ffffff !important; color: #333333 !important;"><span t-if="'incoterm' in doc" t-field="doc.incoterm.code"/></td>
                                    </tr>
                                    <tr style="background-color: #ffffff !important;">
                                        <td style="padding: 4px 6px; background-color: #ffffff !important; color: #333333 !important;">Confirmation Date:</td>
                                        <td style="padding: 4px 6px; text-align: right; background-color: #ffffff !important; color: #333333 !important;"><span t-field="doc.date_order" t-options='{"widget": "date"}'/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Is there a discount on at least one line? -->
                    <t t-set="display_discount" t-value="any([l.discount for l in doc.order_line])"/>

                    <!-- Main Lines Items Table Grid -->
                    <p style="font-weight: bold; margin-bottom: 6px; font-size: 12px; color: #555;">Chi tiết</p>
                    <table class="table table-sm table-bordered" style="table-layout: fixed; width: 100%; border: 1px solid #dee2e6 !important;">
                        <thead>                           
                            <tr style="background-color: #f8f9fa !important; color: #333333 !important; font-size: 11px;">
                                <th style="width: 6%; text-align: center; vertical-align: middle; background-color: #f8f9fa !important; color: #333333 !important;">SN.</th>
                                <th style="width: 19%; vertical-align: middle; background-color: #f8f9fa !important; color: #333333 !important;">P/N</th>
                                <th style="width: 35%; vertical-align: middle; background-color: #f8f9fa !important; color: #333333 !important;">DESCRIPTION</th>
                                <th style="width: 11%; text-align: right; vertical-align: middle; background-color: #f8f9fa !important; color: #333333 !important;">QUANTITY</th>
                                <th style="width: 11%; text-align: right; vertical-align: middle; background-color: #f8f9fa !important; color: #333333 !important;">UNIT PRICE</th>
                                <th t-if="display_discount" style="width: 8%; text-align: right; vertical-align: middle; background-color: #f8f9fa !important; color: #333333 !important;" groups="sale.group_discount_per_so_line">DISC. (%)</th>
                                <th style="width: 10%; text-align: center; vertical-align: middle; background-color: #f8f9fa !important; color: #333333 !important;">TAXES</th>
                                <th style="width: 12%; text-align: right; vertical-align: middle; background-color: #f8f9fa !important; color: #333333 !important;">NET PRICE*</th>
                            </tr>
                        </thead>
                        <tbody class="sale_tbody" style="font-size: 12px; background-color: #ffffff !important;">
                            <t t-set="line_idx" t-value="1"/>
                            <t t-foreach="doc.order_line" t-as="l">
                                <tr t-if="l.product_uom_qty" style="background-color: #ffffff !important;">
                                    <td class="text-center" style="vertical-align: middle; background-color: #ffffff !important; color: #333333 !important;">
                                        <t t-esc="line_idx"/>
                                    </td>
                                    <td style="vertical-align: middle; background-color: #ffffff !important; color: #333333 !important;">
                                        <span t-field="l.product_id.default_code"/>
                                    </td>
                                    <td style="vertical-align: middle; background-color: #ffffff !important; color: #333333 !important;">
                                     <!--   <span t-field="l.product_id.name"/> -->
                                        <span t-field="l.product_id.display_name"/>
                                    </td>
                                    <td class="text-right" style="vertical-align: middle; background-color: #ffffff !important; color: #333333 !important;">
                                        <span t-field="l.product_uom_qty"/>
                                        <span groups="product.group_uom" t-field="l.product_uom"/>
                                    </td>
                                    <td class="text-right" style="vertical-align: middle; background-color: #ffffff !important; color: #333333 !important;">
                                        <span t-field="l.price_unit"/>
                                    </td>
                                    <td t-if="display_discount" class="text-right" groups="sale.group_discount_per_so_line" style="vertical-align: middle; background-color: #ffffff !important; color: #333333 !important;">
                                        <span t-field="l.discount"/>
                                    </td>
                                    <td class="text-center" style="vertical-align: middle; background-color: #ffffff !important; color: #333333 !important;">
                                        <span t-esc="', '.join(map(lambda x: (x.description or x.name), l.tax_id))"/>
                                    </td>
                                    <td class="text-right" style="vertical-align: middle; background-color: #ffffff !important; color: #333333 !important;">
                                        <span t-field="l.price_subtotal" t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}'/>
                                    </td>
                                </tr>
                                <t t-set="line_idx" t-value="line_idx + 1"/>
                            </t>
                        </tbody>
                    </table>

                    <!-- Totals and Financial Breakdown Section -->
                    <div class="row justify-content-end mt24" name="total">
                        <div class="col-5">
                            <table class="table table-sm table-bordered" style="width: 100%; font-size: 13px; border: 1px solid #dee2e6 !important;">
                                <tbody style="background-color: #ffffff !important;">
                                    <tr style="background-color: #ffffff !important;">
                                        <td style="padding: 6px 8px; background-color: #ffffff !important; color: #333333 !important;"><strong>Net of Taxes</strong></td>
                                        <td class="text-right" style="padding: 6px 8px; background-color: #ffffff !important; color: #333333 !important;">
                                            <span t-field="doc.amount_untaxed" t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr style="background-color: #ffffff !important;">
                                        <td style="padding: 6px 8px; background-color: #ffffff !important; color: #333333 !important;">Taxes</td>
                                        <td class="text-right" style="padding: 6px 8px; background-color: #ffffff !important; color: #333333 !important;">
                                            <span t-field="doc.amount_tax" t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}'/>
                                        </td>
                                    </tr>
                                    <tr style="background-color: #f8f9fa !important; font-weight: bold;">
                                        <td style="padding: 6px 8px; background-color: #f8f9fa !important; color: #000000 !important;"><strong>Total</strong></td>
                                        <td class="text-right" style="padding: 6px 8px; background-color: #f8f9fa !important; color: #000000 !important;">
                                            <span t-field="doc.amount_total" t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}'/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    
                    <!-- Terms, Conditions, and Internal Notes -->
                    <div class="mt32" style="border-radius: 4px; padding: 12px; background-color: #fdfdfd; font-size: 12px; border: 1px solid #eee;">
                        <p t-if="doc.note" style="margin-bottom: 0;">
                            <strong>Note:</strong><br/>
                            <span t-field="doc.note"/>
                        </p>
                    </div>
                    
                    <div class="oe_structure"/>
                </div>
            </t>
        </template>
    </data>
</flectra>
