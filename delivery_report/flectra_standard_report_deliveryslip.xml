<?xml version="1.0" encoding="utf-8"?>
<flectra>
    <data>
        <template id="flectra_std_report_deliveryslip_document">
            <!-- Setup Company Context Safely -->
            <t t-if="o and 'company_id' in o">
                <t t-set="company" t-value="o.company_id"/>
            </t>
            <t t-if="not o or 'company_id' not in o">
                <t t-set="company" t-value="res_company"/>
            </t>

            <!-- Document Header Section (Matched to Quotation layout) -->
            <div class="header" style="margin-bottom: 0px; padding-bottom: 0px;">
                <div class="row mt32 mb16">
                    <div class="col-6">
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 80px;"/>
                    </div>
                    <div class="col-6 text-left" style="font:14px sans-serif !important; text-align: center;">
                        <strong t-field="company.partner_id"/><br/>
                        <span t-if="company.partner_id.street" t-field="company.partner_id.street"/><br/>
                        <span t-if="company.partner_id.street2" t-field="company.partner_id.street2"/><br/>
                        <span t-if="company.partner_id.city" t-field="company.partner_id.city"/>
                        <span t-if="company.partner_id.country_id"> <span t-field="company.partner_id.country_id.name"/></span><br/>
                        <span t-if="company.partner_id.vat">MST: <span t-field="company.partner_id.vat"/></span>
                    </div>
                </div>
                <div style="border-top: 1px solid #777777; margin-top: 5px; margin-bottom: 1px; padding: 0;"/>
            </div>

            <!-- Main Layout Context -->
            <t t-call="web.external_layout">
                <t t-set="o" t-value="o.with_context({'lang':o.partner_id.lang})"/>
                <div class="page" style="font-family: sans-serif; font-size: 13px; margin-top: -55px !important;">
                    <div class="oe_structure"/>
                    
                    <!-- Document Title and Customer Block -->
                    <div class="row mb32" style="margin-top: 0px; padding-top: 1px;">
                        <div class="col-6 text-center" style="text-align: center; font-size: 13px; padding-top: 15px;">
                            <h1 style="font-weight: bold; margin-top: 2px; margin-bottom: 2px; font-size: 24px; color: #333333;">PHIẾU GIAO HÀNG</h1>
                            <p style="font-size: 14px; color: #555;">Ref# <span t-field="o.name"/></p>
                            <img t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s' % ('Code128', o.name, 600, 100)" style="width: 300px; height: 25px;"/>
                        </div>

                        <!-- Customer information Section Panels -->                       
                        <div class="col-6" style="padding-right: 5px;">
                            <table class="table table-sm table-bordered" style="table-layout: fixed; width: 100%; border: 1px solid #dee2e6 !important;">
                                <thead>
                                   <tr style="background-color: #f8f9fa !important;"><th colspan="2" style="font-size: 12px; padding: 4px 8px; background-color: #f8f9fa !important; color: #333333 !important; text-align: center; border: 0 !important; border-bottom: 0 !important;"><br/></th></tr>                                                             
                                </thead>
                                <tbody style="background-color: #ffffff !important; color: #333333 !important;">
                                    <tr style="background-color: #ffffff !important;">
                                        <td style="width: 40%; padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><strong>Khách hàng</strong></td>
                                        <td style="width: 60%; padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><span t-field="o.partner_id.name"/></td>
                                    </tr>
                                    <tr style="background-color: #ffffff !important;">
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><strong>Địa chỉ:</strong></td>
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;">
                                            <span t-if="o.partner_id.street" t-field="o.partner_id.street"/> 
                                            <span t-if="o.partner_id.street2" t-field="o.partner_id.street2"/> 
                                            <span t-if="o.partner_id.city" t-field="o.partner_id.city"/> 
                                            <span t-if="o.partner_id.country_id"> <span t-field="o.partner_id.country_id.name"/></span><br/>
                                        </td>
                                    </tr>
                                    <tr style="background-color: #ffffff !important;">
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><strong>Số ĐT:</strong></td>
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><span t-field="o.partner_id.phone"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>                      
                    </div>

                    <!-- Information & Status Meta Blocks -->
                    <div class="row mb16">
                        <div class="col-6" style="padding-right: 5px;">
                            <table class="table table-sm table-bordered" style="table-layout: fixed; width: 100%; border: 1px solid #dee2e6 !important;">
                                <thead style="background-color: #f8f9fa !important;">
                                    <tr style="background-color: #f8f9fa !important;"><th colspan="2" style="font-size: 12px; padding: 4px 8px; background-color: #f8f9fa !important; color: #333333 !important; text-align: center;">THÔNG TIN ĐƠN HÀNG</th></tr>
                                </thead>
                                <tbody style="background-color: #ffffff !important; color: #333333 !important;">
                                    <tr style="background-color: #ffffff !important;">
                                        <td style="width: 40%; padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><strong>Số Phiếu GH:</strong></td>
                                        <td style="width: 60%; padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><span t-field="o.name"/></td>
                                    </tr>
                                    <tr style="background-color: #ffffff !important;">
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><strong>Ngày lên lịch:</strong></td>
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><span t-field="o.scheduled_date" t-options='{"widget": "date"}'/></td>
                                    </tr>
                                    <tr style="background-color: #ffffff !important;">
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><strong>Người phụ trách:</strong></td>
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><span t-field="o.user_id"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
<div class="col-6" style="padding-left: 5px;">
    <table class="table table-sm table-bordered" style="table-layout: fixed; width: 100%; border: 1px solid #dee2e6 !important;">
        <thead style="background-color: #f8f9fa !important;">
            <tr style="background-color: #f8f9fa !important;">
                <th colspan="2" style="font-size: 12px; padding: 4px 8px; background-color: #f8f9fa !important; color: #333333 !important; text-align: center;">TRẠNG THÁI &amp; NGUỒN</th>
            </tr>
        </thead>
        <tbody style="background-color: #ffffff !important; color: #333333 !important;">
            <tr style="background-color: #ffffff !important;">
                <td style="width: 40%; padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><strong>Tài liệu gốc:</strong></td>
                <td style="width: 60%; padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><span t-field="o.origin"/></td>
            </tr>
            
            <!-- Safe extraction of Sale Order for accounting references -->
            <t t-set="sale_order" t-value="o.sale_id if 'sale_id' in o and o.sale_id else False"/>
            
            <!-- 1. INVOICE STATUS -->
            <tr style="background-color: #ffffff !important;">
                <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><strong>Xuất Hóa đơn:</strong></td>
                <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;">
                    <t t-if="sale_order and 'invoice_status' in sale_order">
                        <span t-field="sale_order.invoice_status"/>
                    </t>
                    <t t-else="">
                        <span class="text-muted">Không có thông tin</span>
                    </t>
                </td>
            </tr>

            <!-- 2. PAYMENT STATUS -->
            <tr style="background-color: #ffffff !important;">
                <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><strong>Thanh toán:</strong></td>
                <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;">
                    <t t-if="sale_order and sale_order.invoice_ids">
                        <!-- Pulls the status from the latest generated invoice -->
                        <!--  CORRECTED COMPILER SAFE CODE -->
<t t-set="latest_invoice" t-value="sale_order.invoice_ids.sorted(key=lambda i: i.id, reverse=True)[0] if sale_order.invoice_ids else False"/>
<t t-if="latest_invoice">
    <span t-field="latest_invoice.payment_state"/>
</t>
                    <t t-else="">
                        <span class="text-muted">Chưa tạo hóa đơn</span>
                    </t>
                </td>
            </tr>
        </tbody>
    </table>
</div>

                    </div>

                    <div class="row mb32">
                        <div class="col-12">
                            <table class="table table-sm table-bordered" style="table-layout: fixed; width: 100%; border: 1px solid #dee2e6 !important;">
                                <thead style="background-color: #f8f9fa !important;">
                                    <tr style="background-color: #f8f9fa !important;"><th colspan="2" style="font-size: 12px; padding: 4px 8px; background-color: #f8f9fa !important; color: #333333 !important; text-align: center;">ĐỊA CHỈ GIAO HÀNG (DELIVERY ADDRESS)</th></tr>
                                </thead>
                                <tbody style="background-color: #ffffff !important; color: #333333 !important;">
                                    <tr style="background-color: #ffffff !important;">
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important; width: 20%;"><strong>Địa chỉ nhận:</strong></td>
                                        <td style="padding: 4px 8px; min-height: 60px; background-color: #ffffff !important; color: #333333 !important;">
                                            <!-- Delivery Address Logic Processed safely -->
                                            <div t-if="o.move_ids and o.move_ids.partner_id and o.move_ids.partner_id.id != o.partner_id.id">
                                                <span t-field="o.move_ids.partner_id.name"/><br/>
                                                <span t-field="o.move_ids.partner_id.street"/>
                                                <span t-if="o.move_ids.partner_id.street2"> <span t-field="o.move_ids.partner_id.street2"/></span>
                                                <span t-if="o.move_ids.partner_id.city"> <span t-field="o.move_ids.partner_id.city"/></span>
                                                <span t-if="o.move_ids.partner_id.country_id"> <span t-field="o.move_ids.partner_id.country_id.name"/></span>
                                            </div>
                                            <div t-else="">
                                                <span t-field="o.partner_id.name"/><br/>
                                                <span t-field="o.partner_id.street"/>
                                                <span t-if="o.partner_id.street2"> <span t-field="o.partner_id.street2"/></span>
                                                <span t-if="o.partner_id.city"> <span t-field="o.partner_id.city"/></span>
                                                <span t-if="o.partner_id.country_id"> <span t-field="o.partner_id.country_id.name"/></span>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr style="background-color: #ffffff !important;">
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><strong>Số ĐT liên hệ:</strong></td>
                                        <td style="padding: 4px 8px; background-color: #ffffff !important; color: #333333 !important;"><span t-field="o.partner_id.phone"/></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <p style="font-weight: bold; margin-bottom: 6px; font-size: 12px; color: #555;">Chi Tiết Giao Hàng</p>
                    
                    <table class="table table-sm table-bordered" style="table-layout: fixed; width: 100%; border: 1px solid #dee2e6 !important;" t-if="not o.move_line_ids">
                        <thead>                           
                            <tr style="background-color: #f8f9fa !important; color: #333333 !important; font-size: 11px;">
                                <th style="width: 10%; text-align: center; vertical-align: middle; background-color: #f8f9fa !important; color: #333333 !important;">STT</th>
                                <th style="width: 25%; text-align: center; vertical-align: middle; background-color: #f8f9fa !important; color: #333333 !important;">MÃ SẢN PHẨM</th>
                                <th style="width: 45%; text-align: center; vertical-align: middle; background-color: #f8f9fa !important; color: #333333 !important;">MÔ TẢ SẢN PHẨM</th>
                                <th style="width: 20%; text-align: center; vertical-align: middle; background-color: #f8f9fa !important; color: #333333 !important;">SL ĐẶT HÀNG</th>
                            </tr>
                        </thead>
                        <tbody style="font-size: 12px; background-color: #ffffff !important;">
                            <t t-set="line_idx" t-value="1"/>
                            <tr t-foreach="o.move_ids" t-as="move" style="background-color: #ffffff !important;">
                                <td class="text-center" style="vertical-align: middle;"><t t-esc="line_idx"/></td>
                                <td style="vertical-align: middle;"><span t-field="move.product_id.default_code"/></td>
                                <td style="vertical-align: middle;"><span t-field="move.product_id.display_name"/></td>
                                <td class="text-center" style="vertical-align: middle;">
                                    <span t-field="move.product_uom_qty"/> <span t-field="move.product_uom"/>
                                </td>
                                <t t-set="line_idx" t-value="line_idx + 1"/>
                            </tr>
                        </tbody>
                    </table>

                    <table class="table table-sm table-bordered" style="table-layout: fixed; width: 100%; border: 1px solid #dee2e6 !important;" t-if="o.move_line_ids">
                        <t t-set="has_serial_number" t-value="o.move_line_ids.mapped('lot_id')" groups="stock.group_production_lot"/>
                        <thead>                           
                            <tr style="background-color: #f8f9fa !important; color: #333333 !important; font-size: 11px;">
                                <th style="width: 6%; text-align: center; vertical-align: middle; background-color: #f8f9fa !important; color: #333333 !important;">STT</th>
                                <th style="width: 19%; text-align: center; vertical-align: middle; background-color: #f8f9fa !important; color: #333333 !important;">MÃ SẢN PHẨM</th>
                                <th style="width: 35%; text-align: center; vertical-align: middle; background-color: #f8f9fa !important; color: #333333 !important;">MÔ TẢ SẢN PHẨM</th>
                                <th t-if="has_serial_number" style="width: 15%; text-align: center; vertical-align: middle; background-color: #f8f9fa !important; color: #333333 !important;">SỐ LÔ/SERIAL</th>
                                <th style="width: 12%; text-align: center; vertical-align: middle; background-color: #f8f9fa !important; color: #333333 !important;">SL YÊU CẦU</th>
                                <th t-if="any([move_line.state == 'done' for move_line in o.move_line_ids])" style="width: 13%; text-align: center; vertical-align: middle; background-color: #f8f9fa !important; color: #333333 !important;">SL THỰC GIAO</th>
                            </tr>
                        </thead>
                        <tbody style="font-size: 12px; background-color: #ffffff !important;">
                            <t t-set="line_idx" t-value="1"/>
                            <tr t-foreach="o.move_line_ids" t-as="move_line" style="background-color: #ffffff !important;">
                                <td class="text-center" style="vertical-align: middle;"><t t-esc="line_idx"/></td>
                                <td style="vertical-align: middle;"><span t-field="move_line.product_id.default_code"/></td>
                                <td style="vertical-align: middle;">
                                    <span t-field="move_line.product_id.display_name"/>
                                    <p t-if="o.picking_type_code == 'outgoing'"><small t-field="move_line.product_id.description_pickingout"/></p>
                                    <p t-if="o.picking_type_code == 'incoming'"><small t-field="move_line.product_id.description_pickingin"/></p>
                                </td>
                                <td t-if="has_serial_number" class="text-center" style="vertical-align: middle;">
                                    <span t-field="move_line.lot_id"/>
                                    <t t-if="not move_line.lot_id"><span t-field="move_line.lot_name"/></t>
                                </td>
                                <td class="text-center" style="vertical-align: middle;">
                                    <span t-field="move_line.quantity_product_uom"/> <span t-field="move_line.product_uom_id"/>
                                </td>
                                <td class="text-center" t-if="move_line.state == 'done'" style="vertical-align: middle; font-weight: bold; color: #000;">
                                    <t t-if="move_line.quantity_product_uom != move_line.quantity">
                                        <t t-set="backorder" t-value="True"/>
                                    </t>
                                    <span t-field="move_line.quantity"/> <span t-field="move_line.product_uom_id"/>
                                </td>
                                <t t-set="line_idx" t-value="line_idx + 1"/>
                            </tr>
                        </tbody>
                    </table>

                    <div t-if="o.backorder_id" class="alert alert-warning mt16" style="padding: 8px; font-size: 12px;">
                        Lô hàng này là đơn dở dang (backorder) của thông tin gốc: <t t-esc="o.backorder_id.name"/>.
                    </div>
                    <div t-if="backorder" class="alert alert-info mt16" style="padding: 8px; font-size: 12px;">
                        Một số mặt hàng không thể giao hết hoàn toàn; phần còn lại sẽ được giao ngay khi có sẵn hàng.
                    </div>

                    <div class="row justify-content-end mt24">
                        <div class="col-6" style="padding-left: 5px;">
                            <table class="table table-sm table-bordered" style="table-layout: fixed; width: 100%; border: 0px solid #ffffff !important;">   
                                <tr style="background-color: #ffffff !important; border: 0 !important;"> 
                                    <t t-set="sale_doc" t-value="o.sale_id if 'sale_id' in o and o.sale_id else False"/>
                                    <td style="padding: 4px 8px; text-align: center; background-color: #ffffff !important; border: 0 !important;">
                                    <!-- If linked to a Sale Order, use its portal link with its access token -->
                                    <t t-if="sale_doc and 'access_token' in sale_doc and sale_doc.access_token">
                                    <t t-set="share_url" t-value="'%s/my/orders/%s?access_token=%s' % (sale_doc.get_base_url(), sale_doc.id, sale_doc.access_token)"/>
                                    <img t-att-src="'/report/barcode/QR/%s' % (share_url)" style="width:90px; height:90px; display: block; margin: 0 auto;" alt="System Portal QR"/>
                                    </t>
                                    <!-- Fallback if no Sale Order link exists (e.g., manual stock transfer) -->
                                    <t t-else="">
                                    <img t-att-src="'/report/barcode/QR/%s' % (o.name)" style="width:90px; height:90px; display: block; margin: 0 auto;" alt="System Portal QR"/>
                                    </t>
                                    </td>                                    
                                    <td style="padding: 4px 8px; text-align: center; background-color: #ffffff !important; border: 0 !important; width: 33%;">                                        
                                        <img src="https://gimitec.com/mag/image/0938141821.png" style="width:90px; height:90px; display: inline-block; margin-top: 5px;"/>
                                    </td>
                                </tr>  
                            </table>
                        </div>  
                        <div class="col-6" style="padding-left: 5px;">
                            <table class="table table-sm table-bordered" style="table-layout: fixed; width: 100%; border: 0px solid #ffffff !important;">   
                                <tr style="background-color: #ffffff !important; border: 0 !important;">
                                    <td style="padding: 4px 8px; text-align: center; background-color: #ffffff !important; border: 0 !important; width: 33%;">
                                        <strong>Người Nhận Hàng</strong><br/>
                                        <small style="color: #888;">(Ký, ghi rõ họ tên)</small>
                                    </td>
                                    <td style="padding: 4px 8px; text-align: center; background-color: #ffffff !important; border: 0 !important; width: 33%;"> 
                                    </td>
                                    <td style="padding: 4px 8px; text-align: center; background-color: #ffffff !important; border: 0 !important; width: 33%;">
                                        <strong>Người Giao Hàng / Đại Diện</strong><br/>                                        
                                    </td>
                                    <td style="padding: 4px 8px; text-align: center; background-color: #ffffff !important; border: 0 !important; width: 33%;"> 
                                    </td>
                                </tr>  
                            </table>
                        </div>  
                    </div>

                    <div class="mt32" style="border-radius: 4px; padding: 12px; background-color: #fdfdfd; font-size: 12px; border: 1px solid #eee;">
                        <p style="margin-bottom: 0;">
                            <strong>Ghi chú đơn hàng:</strong><br/>
                            <span t-if="o.note" t-field="o.note"/>
                            <span t-else="">Hàng hóa giao đi đầy đủ phụ kiện kèm theo và nguyên đai kiện tiêu chuẩn nhà sản xuất.</span>
                        </p>
                    </div>

                    <div class="oe_structure"/>
                </div>
            </t>
        </template>
    </data>
</flectra>
